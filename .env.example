# Used by docker-compose.yml. Copy to .env and fill in.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# Optional: lets you run "docker compose exec api node scripts/createAdmin.js"
ADMIN_EMAIL=admin@hustlehub.local
ADMIN_PASSWORD=
