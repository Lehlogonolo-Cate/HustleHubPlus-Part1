# ---- Server ----
PORT=4000
APP_NAME=HustleHub+
NODE_ENV=development
# HTTPS is on by default; certificates are read from ./certs (see README "HTTPS")
USE_HTTPS=true
# Comma-separated list of frontend origins allowed by CORS
CLIENT_ORIGIN=https://localhost:5173
# Number of trusted reverse proxies in front of the API (0 locally, 1 behind nginx in Docker)
TRUST_PROXY=0

# ---- Database ----
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/hustlehub

# ---- Authentication ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_your_secret
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ---- Rate limits (requests per window) ----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_GENERAL=300
RATE_LIMIT_AUTH=10
RATE_LIMIT_BOOKING=20

# ---- Business rules ----
# Share of each booking kept by the platform (0.1 = 10%)
PLATFORM_FEE_RATE=0.1

# ---- Logging ----
LOG_LEVEL=info

# ---- Admin account (used only by: npm run create-admin) ----
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@hustlehub.local
ADMIN_PASSWORD=replace_with_a_strong_password
